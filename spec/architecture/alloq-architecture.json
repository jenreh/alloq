  "cards": [
    {
      "dot": "emerald",
      "title": "Layering",
      "items": [
        "Each feature package: pages → Reflex states → services → alloq-commons repositories",
        "Repositories extend appkit-commons BaseRepository on an AsyncSession",
        "UI uses appkit_mantine plus a custom ExcelGrid JSX component",
        "components/* are uv workspace packages with their own tests"
      ]
    },
    {
      "dot": "cyan",
      "title": "Web runtime",
      "items": [
        "Docker image runs start.sh: alembic upgrade head, then reflex run --single-port :8080",
        "configuration/config.yaml + PROFILES overlays; secret: refs resolved by SECRET_PROVIDER",
        "ForceHTTPSMiddleware honors X-Forwarded-Proto from trusted proxies"
      ]
    },
    {
      "dot": "violet",
      "title": "Desktop runtime",
      "items": [
        "Tauri starts the same Reflex backend in-process on 127.0.0.1:18442",
        "No bundled secrets: each user signs in with Entra and connects with their own token",
        "Sign-in stops if alembic_version differs from app/desktop/schema.py; migrations run only on the server"
      ]
    },
    {
      "dot": "rose",
      "title": "Access control",
      "items": [
        "Dashboard and team pages are admin-only",
        "Sessions time out after 25 min; Azure OAuth on, GitHub commented out",
        "Desktop DB role <db>_app is granted per user from the users page"
      ]
    }
  ]
