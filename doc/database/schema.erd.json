  "cards": [
    {
      "dot": "cyan",
      "title": "Conventions",
      "items": [
        "Types are PostgreSQL; a trailing null marks a nullable column, all others are NOT NULL.",
        "id, created and updated come from the appkit Entity base class.",
        "Relationship labels give the ON DELETE action of the foreign key.",
        "employee_roles and project_owners are pure join tables with a composite primary key.",
        "employees.manager_id points back at employees.id (on delete set null); self-references are not drawn."
      ]
    },
    {
      "dot": "violet",
      "title": "Composite unique and check constraints",
      "items": [
        "capacities: unique (project_id, employee_id, role_id); end_date >= start_date.",
        "capacity_allocations: unique (project_id, employee_id, role_id, week_start); person_days >= 0.",
        "required_capacities: person_days >= 0.",
        "projects and absences: end_date >= start_date.",
        "project_statuses: progress and budget_spent between 0 and 100.",
        "auth_oauth_accounts: unique (provider, account_id); auth_password_history: unique (user_id, password_hash)."
      ]
    },
    {
      "dot": "amber",
      "title": "Not created by Alembic",
      "items": [
        "auth_password_history, auth_password_reset_tokens and auth_password_reset_requests are mapped by appkit_user.",
        "No migration in alembic/versions creates them, so a migrated database lacks these three tables."
      ]
    },
    {
      "dot": "emerald",
      "title": "Keeping this in sync",
      "items": [
        "Source: doc/database/schema.erd.json. tests/test_schema_doc.py compares it with Base.metadata.",
        "After a model or migration change, update the JSON and re-render this page."
      ]
    }
  ]
