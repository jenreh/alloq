{
  "schema_version": 1,
  "diagram_type": "erd",
  "meta": {
    "title": "alloq database schema",
    "subtitle": "All tables on Base.metadata (alloq_commons + appkit_user), PostgreSQL types",
    "locale": "en",
    "output": "doc/database/schema.html",
    "quality_profile": "standard",
    "views": [
      {
        "id": "projects_view",
        "label": "Projects",
        "focus": [
          "projects",
          "project_statuses",
          "risks",
          "project_owners"
        ],
        "note": "projects is the hub; status history, risks and owners hang off it and are deleted with it."
      },
      {
        "id": "staffing_view",
        "label": "Staffing and planning",
        "focus": [
          "required_capacities",
          "capacities",
          "capacity_allocations",
          "projects",
          "employees",
          "roles"
        ],
        "note": "Demand per role, assignment per employee and role, and weekly person days per employee."
      },
      {
        "id": "people_view",
        "label": "People",
        "focus": [
          "employees",
          "departments",
          "roles",
          "employee_roles",
          "absences"
        ],
        "note": "Employees belong to one department, have one key role, and can fill many roles."
      },
      {
        "id": "auth_view",
        "label": "Authentication",
        "focus": [
          "auth_users",
          "auth_sessions",
          "auth_oauth_accounts",
          "auth_oauth_states",
          "auth_password_history",
          "auth_password_reset_tokens",
          "auth_password_reset_requests"
        ],
        "note": "Tables owned by the appkit_user package; no foreign key reaches the planning tables."
      }
    ]
  },
  "layout": {
    "mode": "grid",
    "gapX": 80,
    "gapY": 36,
    "entityW": 260
  },
