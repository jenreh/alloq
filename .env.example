PROFILES=local
#PROFILES=devcontainer

SECRET_PROVIDER=local
REFLEX_SOCKET_TIMEOUT=600
UV_PROJECT_ENVIRONMENT=.venv.mac

#####
# local secret provider: one variable per `secret:<name>` in
# configuration/config.yaml (upper case, dashes become underscores)

common-db-encryption-key=<your fernet encryption key here>
alloq-db-user=<your db user here>
alloq-db-password=<your db password here>
alloq-db-host=<your db host here>
alloq-db-name=<your db name here>

# Azure sign-in (Entra ID)
common-oauth-azure-client-id=<your azure client id here>
common-oauth-azure-client-secret=<your azure client secret here>
common-oauth-azure-tenant-id=<your azure tenant id here>

# Optional: Azure OpenAI for the offer workshop (ai_provider: azure)
#APP__OFFER_WORKSHOP__AZURE_OPENAI__API_KEY=<your api key here>

# Optional: Github OAuth
common-oauth-github-client-id=<your github client id here>
common-oauth-github-client-secret=<your github client secret here>
